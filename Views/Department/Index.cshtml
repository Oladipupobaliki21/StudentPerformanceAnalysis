@{
}

@model IEnumerable<StudentPerformanceAnalysis.DTO.DepartmentD.DepartmentDto>

@{
    ViewData["Title"] = "Departments";
}

<div class="page-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Departments</h2>
            <p class="text-muted">
                Manage academic departments in your institution.
            </p>
        </div>

        <a asp-controller="Department"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Add Department
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Department Name</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var department in Model)
                            {
                                <tr>
                                    <td>@department.Id</td>
                                    <td class="fw-semibold">
                                        @department.Name
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@department.Id"
                                           class="btn btn-sm btn-outline-info">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@department.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@department.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted py-4">
                                    No departments found. Add your first
                                    department to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

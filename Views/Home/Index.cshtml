@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<!-- ================= NAVIGATION BAR ================= -->

<nav class="landing-navbar">
    <div class="landing-container nav-content">

        <a asp-controller="Home"
           asp-action="Index"
           class="brand-logo">

            <span class="brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </span>

            <span>
                Student Performance
                <strong>Analysis</strong>
            </span>
        </a>

        <div class="nav-links">
            <a href="#home" class="active">Home</a>
            <a href="#about">About</a>
            <a href="#features">Features</a>
            <a href="#contact">Contact</a>
        </div>

        <div class="nav-actions">
            <a asp-controller="Account"
               asp-action="Login"
               class="btn-login">
                Login
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn-get-started">
                Get Started
            </a>
        </div>

    </div>
</nav>


<!-- ================= HERO SECTION ================= -->

<section class="hero-section" id="home">

    <div class="landing-container hero-grid">

        <div class="hero-content">

            <span class="hero-badge">
                Smarter Data. Better Decisions.
            </span>

            <h1>
                Student Performance
                Analysis &amp; Statistical
                Reporting System
            </h1>

            <p>
                Track student performance, manage academic records,
                and generate insightful reports — all in one place.
                Empower educators and institutions with data-driven
                insights for better learning outcomes.
            </p>

            <div class="hero-buttons">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn-primary-custom">

                    <i class="bi bi-rocket-takeoff-fill"></i>
                    Get Started
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn-secondary-custom">

                    <i class="bi bi-person-fill"></i>
                    Login
                </a>

            </div>

            <div class="hero-trust">
                <span>
                    <i class="bi bi-shield-check"></i>
                    Organized Academic Records
                </span>

                <span>
                    <i class="bi bi-bar-chart-line"></i>
                    Data-Driven Insights
                </span>
            </div>

        </div>


        <!-- HERO ILLUSTRATION -->

        <div class="hero-illustration">

            <div class="illustration-glow"></div>

            <div class="floating-card floating-card-one">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Performance Trends</span>
            </div>

            <div class="dashboard-preview">

                <div class="preview-header">
                    <div>
                        <span class="preview-dot"></span>
                        <span class="preview-dot"></span>
                        <span class="preview-dot"></span>
                    </div>

                    <span>Academic Analytics</span>
                </div>

                <div class="preview-body">

                    <div class="preview-sidebar">
                        <i class="bi bi-grid-fill"></i>
                        <i class="bi bi-people-fill"></i>
                        <i class="bi bi-book-fill"></i>
                        <i class="bi bi-calendar-check-fill"></i>
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>

                    <div class="preview-content">

                        <h5>Performance Overview</h5>

                        <div class="preview-stats">
                            <div>
                                <small>Students</small>
                                <strong>120</strong>
                            </div>

                            <div>
                                <small>Courses</small>
                                <strong>18</strong>
                            </div>
                        </div>

                        <div class="chart-preview">

                            <div class="chart-bar bar-one"></div>
                            <div class="chart-bar bar-two"></div>
                            <div class="chart-bar bar-three"></div>
                            <div class="chart-bar bar-four"></div>
                            <div class="chart-bar bar-five"></div>
                            <div class="chart-bar bar-six"></div>

                        </div>

                        <div class="preview-footer">
                            <span>
                                <i class="bi bi-circle-fill"></i>
                                Academic Performance
                            </span>

                            <span>Overview</span>
                        </div>

                    </div>

                </div>

            </div>

            <div class="floating-card floating-card-two">
                <i class="bi bi-mortarboard-fill"></i>

                <div>
                    <strong>Student Success</strong>
                    <small>Powered by data</small>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- ================= FEATURES SECTION ================= -->

<section class="features-section" id="features">

    <div class="landing-container">

        <div class="section-heading">

            <span class="section-label">OUR FEATURES</span>

            <h2>
                Everything You Need to Manage Student Success
            </h2>

            <p>
                A centralized solution for academic management,
                student performance monitoring, and statistical analysis.
            </p>

        </div>


        <div class="features-grid">

            <!-- STUDENTS -->

            <div class="feature-card">

                <div class="feature-icon icon-purple">
                    <i class="bi bi-people-fill"></i>
                </div>

                <h3>Student Management</h3>

                <p>
                    Register students and maintain organized
                    academic records and profiles.
                </p>

                @* <a asp-controller="Account"
                   asp-action="Login"
                   class="feature-link"
                   aria-label="Login to access student management">

                    <i class="bi bi-arrow-right"></i> *@
                </a>

            </div>


            <!-- COURSES -->

            <div class="feature-card">

                <div class="feature-icon icon-blue">
                    <i class="bi bi-book-half"></i>
                </div>

                <h3>Course Management</h3>

                <p>
                    Organize courses, course codes, units,
                    and academic information.
                </p>

                @* <a asp-controller="Account"
                   asp-action="Login"
                   class="feature-link"
                   aria-label="Login to access course management">

                    <i class="bi bi-arrow-right"></i>
                </a> *@

            </div>


            <!-- ATTENDANCE -->

            <div class="feature-card">

                <div class="feature-icon icon-green">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>

                <h3>Attendance Tracking</h3>

                <p>
                    Record class attendance and monitor
                    student participation.
                </p>

                @* <a asp-controller="Account"
                   asp-action="Login"
                   class="feature-link"
                   aria-label="Login to access attendance tracking">

                    <i class="bi bi-arrow-right"></i>
                </a> *@

            </div>


            <!-- RESULTS -->

            <div class="feature-card">

                <div class="feature-icon icon-orange">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>

                <h3>Results Management</h3>

                <p>
                    Record student scores and analyze
                    academic results by course and semester.
                </p>

                @* <a asp-controller="Account"
                   asp-action="Login"
                   class="feature-link"
                   aria-label="Login to access results management"> *@

                    @* <i class="bi bi-arrow-right"></i> *@
                @* </a> *@

            </div>


            <!-- STATISTICS -->

            <div class="feature-card">

                <div class="feature-icon icon-indigo">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>

                <h3>Statistical Reports</h3>

                <p>
                    Discover performance patterns and
                    use statistical summaries to support decisions.
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="feature-link"
                   aria-label="Login to access statistical reports">

                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

</section>


<!-- ================= ABOUT SECTION ================= -->

<section class="about-section" id="about">

    <div class="landing-container about-grid">

        <div class="about-visual">

            <div class="about-visual-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <h3>Turning Student Data Into Meaningful Insights</h3>

            <p>
                Better academic decisions begin with
                well-organized and properly analyzed data.
            </p>

            <div class="about-visual-chart">
                <span style="height: 35%"></span>
                <span style="height: 55%"></span>
                <span style="height: 45%"></span>
                <span style="height: 75%"></span>
                <span style="height: 95%"></span>
            </div>

        </div>


        <div class="about-content">

            <span class="section-label">ABOUT THE SYSTEM</span>

            <h2>
                Making Academic Data More Meaningful
            </h2>

            <p>
                The Student Performance Analysis and Statistical
                Reporting System is designed to help institutions
                manage academic information and understand student
                performance more effectively.
            </p>

            <p>
                By organizing student records, course information,
                examination results, and attendance data, the system
                provides a foundation for statistical summaries and
                evidence-based academic decisions.
            </p>

            <div class="mission-box">

                <div class="mission-icon">
                    <i class="bi bi-bullseye"></i>
                </div>

                <div>
                    <h4>Our Mission</h4>

                    <p>
                        To support better educational outcomes through
                        organized data, academic monitoring, and
                        statistical analysis.
                    </p>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= BENEFITS SECTION ================= -->

<section class="benefits-section">

    <div class="landing-container benefits-grid">

        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div>
                <h3>Academic</h3>
                <p>Record Management</p>
            </div>
        </div>


        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>

            <div>
                <h3>Efficient</h3>
                <p>Information Access</p>
            </div>
        </div>


        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <h3>Secure</h3>
                <p>Access Control</p>
            </div>
        </div>


        <div class="benefit-item">
            <div class="benefit-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <div>
                <h3>Data-Driven</h3>
                <p>Better Decisions</p>
            </div>
        </div>

    </div>

</section>


<!-- ================= CALL TO ACTION ================= -->

<section class="cta-section">

    <div class="landing-container">

        <div class="cta-content">

            <div>
                <h2>Ready to Get Started?</h2>

                <p>
                    Explore a smarter way to organize academic records
                    and understand student performance.
                </p>
            </div>

            <div class="cta-buttons">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="cta-login">
                    <i class="bi bi-person-fill"></i>
                    Login
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="cta-register">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                    Get Started
                </a>

            </div>

        </div>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer class="landing-footer" id="contact">

    <div class="landing-container">

        <div class="footer-grid">

            <div class="footer-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="footer-logo">

                    <i class="bi bi-mortarboard-fill"></i>

                    <span>
                        Student Performance
                        <strong>Analysis</strong>
                    </span>

                </a>

                <p>
                    Better academic records.
                    Meaningful statistical insights.
                </p>

            </div>


            <div class="footer-column">

                <h4>Quick Links</h4>

                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#features">Features</a>

            </div>


            <div class="footer-column">

                <h4>Account</h4>

                <a asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>

                <a asp-controller="Account"
                   asp-action="Register">
                    Get Started
                </a>

            </div>


            <div class="footer-column">

                <h4>Our Goal</h4>

                <p>
                    Empowering better educational decisions
                    through academic data and statistical analysis.
                </p>

            </div>

        </div>


        <div class="footer-bottom">

            <p>
                &copy; @DateTime.Now.Year Student Performance Analysis.
                All rights reserved.
            </p>

            <span>Empowering Education Through Data</span>

        </div>

    </div>

</footer>